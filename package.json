{
  "name": "travel-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Flight-first Travel Booking Platform MVP",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:api": "npm run dev --workspace=@travel-platform/api",
    "dev:web": "npm run dev --workspace=@travel-platform/web",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "echo 'Checking workspaces...'",
    "deploy:api": "npm run build --workspace=@travel-platform/api && npx wrangler deploy --config apps/api/wrangler.toml",
    "deploy:web": "npm run build --workspace=@travel-platform/web && npx wrangler pages deploy apps/web/dist"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}

